# ========================================================
# Naviport - Variables de Entorno del Proyecto
# Copiar este archivo a .env y ajustar valores si es necesario
# ========================================================

# --- Puertos de Servicios ---
APP_PORT=3000
FRONTEND_PORT=8100

# --- MongoDB Config ---
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=naviport_secret_password
MONGO_INITDB_DATABASE=naviport
MONGO_URI=mongodb://admin:naviport_secret_password@localhost:27017/naviport?authSource=admin

# --- Redis Config ---
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=redis_naviport_secret

# --- Mongo Express (GUI Web opcional en http://localhost:8081) ---
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# --- JWT & Autenticación ---
JWT_SECRET=super_secret_jwt_key_naviport_change_me
JWT_EXPIRES_IN=7d
